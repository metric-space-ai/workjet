# Optional: Workjet Connect source builds
# `cp .env.example .env` enables Workjet Connect against the production deployment.
# These are the same public identifiers baked into official release builds, not
# secrets. Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
WORKJET_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
WORKJET_CLERK_JWT_TEMPLATE=workjet-relay
WORKJET_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in WORKJET_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# WORKJET_APPLE_TEAM_ID=ABC1234567
# WORKJET_MACOS_PROVISIONING_PROFILE=/absolute/path/to/workjet.provisionprofile
# WORKJET_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
WORKJET_RELAY_URL=https://relay.workjet.codes

# Public Workjet control-plane origin used for instance-bound device pairing.
# The mobile app never sends Business OS records through this endpoint.
EXPO_PUBLIC_WORKJET_MANAGED_CONTROL_URL=https://ctox.dev

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.workjet.codes; override to test against a staging deployment.
# WORKJET_HOSTED_APP_URL=https://nightly.app.workjet.codes

# Optional public, ingest-only OpenTelemetry configuration. Workjet ships with
# client-side trace export disabled; Cloudflare Worker logs are the production
# default.
# WORKJET_MOBILE_OTLP_TRACES_URL=https://collector.example.com/v1/traces
# WORKJET_MOBILE_OTLP_TRACES_DATASET=workjet-mobile
# WORKJET_MOBILE_OTLP_TRACES_TOKEN=...
